{
  "name": "pi-peers",
  "version": "0.3.0",
  "description": "Discovery and messaging between pi coding agents: same-host IPC, cross-host over SSH, no registry",
  "keywords": [
    "pi-package",
    "pi-extension",
    "peer",
    "peer-messaging",
    "agents",
    "ssh"
  ],
  "license": "MIT",
  "author": "Radovan Chytracek <radovan.chytracek@rcconsult.biz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcconsult/pi-peers.git"
  },
  "homepage": "https://github.com/rcconsult/pi-peers#readme",
  "bugs": "https://github.com/rcconsult/pi-peers/issues",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "bin": {
    "pi-peers": "dist/cli.js"
  },
  "files": [
    "src",
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "gen:types": "node scripts/gen-types.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "prepack": "npm run gen:types && npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2"
  }
}
